# Environment variables for mfi-server. Copy this file, fill in the values you
# need and leave the others empty: an empty value means "use the file or the default".

# TCP port where the devices send their inform packets (default 6080).
MFI_INFORM_PORT=

# UDP port for the wake-up packets sent to the devices (default 3478).
MFI_WAKEUP_PORT=

# Address the servers listen on (default 0.0.0.0, all interfaces).
MFI_BIND_ADDRESS=

# Path of a .unf controller backup used to import the device keys (empty = none).
MFI_BACKUP_FILE=

# Log level: debug, info, warning or error (default info).
MFI_LOG_LEVEL=

# Host name or address of the MQTT broker (empty = MQTT off, unless the Supervisor provides one).
MFI_MQTT_HOST=

# Port of the MQTT broker (default 1883).
MFI_MQTT_PORT=

# User name for the MQTT broker (empty = no user name).
MFI_MQTT_USERNAME=

# Password for the MQTT broker (empty = no password). Keep it out of version control.
MFI_MQTT_PASSWORD=

# Prefix of the MQTT topics where the states are published (default mfi).
MFI_MQTT_TOPIC_PREFIX=

# Prefix of the Home Assistant MQTT discovery topics (default homeassistant).
MFI_MQTT_DISCOVERY_PREFIX=

# Port of the web page and of the JSON API (default 8099).
MFI_WEB_PORT=

# Days of measurement history kept, from 1 to 3650 (default 30).
MFI_HISTORY_DAYS=

# Add-on mode: address of the Home Assistant ingress; only requests from it are served (default 172.30.32.2).
MFI_INGRESS_PEER=
